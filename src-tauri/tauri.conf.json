{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Base",
  "version": "1.0.0",
  "identifier": "com.basepoint.pos",
  "build": {
    "beforeDevCommand": "pnpm run dev:frontend",
    "devUrl": "http://localhost:5374",
    "beforeBuildCommand": "pnpm run build:frontend",
    "frontendDist": "../../biggie_pos/dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["base"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Hospitality-POS/base_desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwODVFMjAwQjEyRDY1OEIKUldTTFpTMnhBT0tGNE5Qb2dFbUxxdHNDUG9JdTYveVVUeWpCbC9BbWF2Z0FiTmlRdXk1b0FQenoK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Base",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
